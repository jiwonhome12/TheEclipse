<Window x:Class="SeatManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="동서대학교 좌석 및 기자재 관리 시스템" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        MinHeight="720" MinWidth="1100">

    <Window.Resources> 
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <!-- Simplified standard styling for scrollbars -->
        </Style>

        <!-- Base Button Styles -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderThickness="4,0,0,0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#111827"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderThickness="4,0,0,0" BorderBrush="#60A5FA" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Bar Action Button -->
        <Style x:Key="ActionBarBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Semester Radio Button Style -->
        <Style x:Key="SemesterRadioBtn" TargetType="RadioButton">
            <Setter Property="GroupName" Value="CabinetSemester"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            팝업의 아이콘 버튼(✕ 등).
            기본 Button 템플릿을 쓰면 글자 상자 + Padding + 테마 테두리까지가 클릭 범위라
            아이콘보다 한참 넓은 곳을 눌러도 반응한다. 아이콘 크기에 맞춘 정사각형으로 고정하고,
            그 사각형을 그대로 그려서 '보이는 곳 = 눌리는 곳'이 되게 한다.
        -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            팝업의 글자 버튼(저장·취소 등).
            테두리가 곧 버튼 전체가 되므로 둥근 모서리 밖을 눌러도 반응하는 일이 없다.
            (기본 템플릿은 마우스를 올리면 테마 하늘색이 Background를 덮어써서 색도 어긋난다)
        -->
        <Style x:Key="ModalBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Menu -->
            <ColumnDefinition Width="220"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Grid Grid.Column="0" Background="#0A1C3E">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo Area -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="DSU" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" 동서대학교" Foreground="#93C5FD" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,3,0,0"/>
            </StackPanel>

            <!-- Sidebar Buttons -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Button x:Name="BtnDashboard" Content="🏠 대시보드" Style="{StaticResource SidebarBtnActive}" Click="BtnDashboard_Click"/>
                <Button x:Name="BtnEquipment" Content="🔧 기자재 현황" Style="{StaticResource SidebarBtn}" Click="BtnEquipment_Click"/>
                <Button x:Name="BtnCabinet" Content="🗄️ 캐비닛 현황" Style="{StaticResource SidebarBtn}" Click="BtnCabinet_Click"/>
                <Button x:Name="BtnSangsangLab" Content="💡 상상Lab 승인" Style="{StaticResource SidebarBtn}" Click="BtnSangsangLab_Click"/>
                <Button x:Name="BtnDataManage" Content="📊 데이터 관리" Style="{StaticResource SidebarBtn}" Click="BtnDataManage_Click"/>
                <Button x:Name="BtnSettings" Content="⚙️ 설정" Style="{StaticResource SidebarBtn}" Click="BtnSettings_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header -->
                <RowDefinition Height="75"/>
                <!-- Tab Workspace Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="대시보드" FontSize="18" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Alert / Status Badges (Only relevant for Dashboard) -->
                    <StackPanel x:Name="HeaderAlertArea" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0">
                        <!-- SangsangLab Approval Alert Card -->
                        <Border x:Name="CardSangsangLabAlert" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" MouseDown="AlertSangsangLab_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡" FontSize="18" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="상상Lab 승인 대기" FontSize="10" Foreground="#991B1B" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtSangsangLabCount" Text="0건" FontSize="12" Foreground="#DC2626" FontWeight="Bold"/>
                                    <TextBlock Text="승인 필요" FontSize="9" Foreground="#991B1B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cabinet Approval Alert Card -->
                        <Border x:Name="CardCabinetAlert" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" MouseDown="AlertCabinet_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗄️" FontSize="18" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="캐비닛 승인 대기" FontSize="10" Foreground="#9A3412" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtCabinetCount" Text="0건" FontSize="12" Foreground="#EA580C" FontWeight="Bold"/>
                                    <TextBlock Text="승인 필요" FontSize="9" Foreground="#9A3412"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Equipment Approval Alert Card -->
                        <Border x:Name="CardEquipmentAlert" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,6" Cursor="Hand" MouseDown="AlertEquipment_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔧" FontSize="18" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="기자재 승인 대기" FontSize="10" Foreground="#991B1B" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtEquipmentCount" Text="0건" FontSize="12" Foreground="#DC2626" FontWeight="Bold"/>
                                    <TextBlock Text="승인 필요" FontSize="9" Foreground="#991B1B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Profile & DateTime -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Profile Card -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="16" Foreground="#4B5563" Margin="0,0,5,0"/>
                            <TextBlock Text="관리자" FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                            <TextBlock Text=" ∨" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Date Display -->
                        <Border Background="#F3F4F6" Padding="10,6" CornerRadius="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅 " FontSize="12" Foreground="#4B5563"/>
                                <TextBlock x:Name="TxtCurrentDate" Text="2026-07-16 (목)" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WORKSPACE TABS CONTAINER -->
            <Grid Grid.Row="1">
                <!-- ================= TAB 1: DASHBOARD ================= -->
                <Grid x:Name="TabDashboard" Visibility="Visible" Background="#F9FAFB">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="15">
                        <Grid.RowDefinitions>
                            <!-- Search & Action Controls -->
                            <RowDefinition Height="Auto"/>
                            <!-- Seat Grid ScrollViewer -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Control & Filter Bar -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,15" VerticalAlignment="Center">
                            <!-- Year/Semester Search Panel -->
                            <Border Background="#1F2937" CornerRadius="6" Padding="15,10" VerticalAlignment="Center" Margin="0,0,15,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="년도" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ComboSearchYear" Width="100" Padding="5" SelectedIndex="0"/>

                                    <TextBlock Text="학기" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="25,0,8,0"/>
                                    <ComboBox x:Name="ComboSearchSemester" Width="120" Padding="5" SelectedIndex="0">
                                        <ComboBoxItem Content="1학기"/>
                                        <ComboBoxItem Content="여름방학"/>
                                        <ComboBoxItem Content="2학기"/>
                                        <ComboBoxItem Content="겨울방학"/>
                                    </ComboBox>

                                    <Button Content="🔍 조회" Background="#111827" Foreground="White" BorderThickness="0" 
                                            FontWeight="Bold" Padding="15,6" Margin="20,0,0,0" Cursor="Hand" Click="BtnSearch_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Button x:Name="BtnRefresh" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" Width="35" Height="35" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                                <Button x:Name="BtnSyncData" Content="데이터 동기화" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnSyncData_Click"/>
                                <Button Content="랜덤 배정" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnRandomAllocation_Click"/>
                                <Button x:Name="BtnSeatFixMode" Content="좌석 고정 모드" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnSeatFixMode_Click"/>
                                <Button x:Name="BtnSeatDeleteMode" Content="좌석 데이터 삭제" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnSeatDeleteMode_Click"/>
                                <Button x:Name="BtnImportDashboardExcel" Content="📤 엑셀 내보내기" Style="{StaticResource ActionBarBtn}" Click="BtnImportDashboardExcel_Click"/>
                                <Button x:Name="BtnDeleteSelected" Content="선택된 좌석 삭제" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="Bold" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnDeleteSelected_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Grid of Seats -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid x:Name="SeatGridContainer">
                                    <!-- Dynamic seat UI will be constructed here code-behind matching the screenshot layout -->
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Memo Sidebar -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="메모" FontSize="16" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

                            <!-- Memo List -->
                            <ListBox Grid.Row="1" x:Name="LstMemos" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔵 " Foreground="#2563EB" VerticalAlignment="Center" Grid.Column="0"/>
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" Foreground="#374151" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="✎" Foreground="#2563EB" Background="Transparent" BorderThickness="0"
                                                        FontWeight="Bold" Grid.Column="2" Cursor="Hand" Click="BtnEditMemo_Click" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                <Button Content="✕" Foreground="#EF4444" Background="Transparent" BorderThickness="0"
                                                        FontWeight="Bold" Grid.Column="3" Cursor="Hand" Click="BtnDeleteMemo_Click" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add Memo Input -->
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBox x:Name="TxtNewMemo" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                                         BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,8" Padding="5"/>
                                <Button x:Name="BtnAddMemo" Content="+ 메모 추가" Background="#2563EB" Foreground="White" BorderThickness="0" 
                                        Padding="0,8" FontWeight="Bold" Cursor="Hand" Click="BtnAddMemo_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= TAB 2: EQUIPMENT STATUS ================= -->
                <Grid x:Name="TabEquipment" Visibility="Collapsed" Background="#F9FAFB" Margin="20">
                    <Grid.RowDefinitions>
                        <!-- Top Alert Card & Action Buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- Spacer -->
                        <RowDefinition Height="10"/>
                        <!-- Section 1: 기자재 신청 현황 (구글폼) -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <!-- Spacer -->
                        <RowDefinition Height="15"/>
                        <!-- Section 2: 기자재 대여 현황 -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Alert & Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Alert Card -->
                        <Border Grid.Column="0" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,6" Cursor="Hand" MouseDown="AlertEquipment_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕒" FontSize="18" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="기자재 승인 대기" FontSize="10" Foreground="#9A3412" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtEquipmentPendingCount" Text="7건" FontSize="12" Foreground="#EA580C" FontWeight="Bold"/>
                                    <TextBlock Text="빠른 확인 필요" FontSize="9" Foreground="#9A3412"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRentalHistory" Content="📋 대여 내역" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnRentalHistory_Click"/>
                            <!-- Tag가 내역 창에서 보여줄 구분이다 (기자재 내역은 여기서만 본다) -->
                            <Button x:Name="BtnEquipmentApprovalHistory" Content="📋 승인/반려 내역" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Tag="기자재" Click="BtnShowApprovalHistory_Click"/>
                            <TextBlock Text="🔍 검색: " VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#374151" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtSearchEquipment" Width="120" Padding="5" VerticalAlignment="Center" Margin="0,0,10,0" KeyUp="TxtSearchEquipment_KeyUp"/>
