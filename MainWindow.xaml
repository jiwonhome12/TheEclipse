                         가로세로 비율을 유지한 채 통째로 확대/축소되도록 Viewbox로 감싼다 -->
                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="1340" Height="785" Margin="20">
                        <Grid.RowDefinitions>
                            <!-- Top Alert Card & Action Buttons -->
                            <RowDefinition Height="Auto"/>
                            <!-- Spacer -->
                            <RowDefinition Height="10"/>
                            <!-- Section 1: 캐비닛 신청 현황 (구글폼) -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="160"/>
                            <!-- Spacer -->
                            <RowDefinition Height="15"/>
                            <!-- Section 2: 캐비닛 배치도 및 현황 -->
                            <RowDefinition Height="*"/>
                            <!-- Bottom Status Counters -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Bar: Alert & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Alert Card -->
                            <Border Grid.Column="0" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,6" Cursor="Hand" MouseDown="AlertEquipment_MouseDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒" FontSize="18" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="캐비닛 승인 대기" FontSize="10" Foreground="#9A3412" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCabinetPendingCount" Text="7건" FontSize="12" Foreground="#EA580C" FontWeight="Bold"/>
                                        <TextBlock Text="빠른 확인 필요" FontSize="9" Foreground="#9A3412"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="🔍 검색: " VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#374151" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtSearchCabinet" Width="120" Padding="5" VerticalAlignment="Center" Margin="0,0,10,0" KeyUp="TxtSearchCabinet_KeyUp"/>
                                <Button x:Name="BtnShowApprovalHistory" Content="📋 승인/반려 내역" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Tag="캐비닛" Click="BtnShowApprovalHistory_Click"/>
                                <Button x:Name="BtnCabinetDelete" Content="캐비닛 데이터 삭제" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnCabinetDelete_Click"/>
                                <Button x:Name="BtnCabinetFix" Content="캐비닛 데이터 고정" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnCabinetFix_Click"/>
                                <Button x:Name="BtnCabinetExport" Content="캐비닛 데이터 추출" Style="{StaticResource ActionBarBtn}" Margin="0,0,8,0" Click="BtnCabinetExport_Click"/>
                                <Button x:Name="BtnImportCabinetExcel" Content="📥 엑셀 가져오기" Style="{StaticResource ActionBarBtn}" Click="BtnImportCabinetExcel_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Section 1 Header -->
                        <TextBlock Grid.Row="2" Text="캐비닛 신청 현황 (구글폼)" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>

                        <!-- Section 1 DataGrid -->
                        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DataGrid x:Name="GridCabinetApprovals" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40" BorderThickness="0" Background="Transparent" AlternationCount="2" AlternatingRowBackground="#F3F4F6" RowBackground="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="신청 일자" Binding="{Binding RequestDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="학번" Binding="{Binding StudentId}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="이름" Binding="{Binding StudentName}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="대여 기간" Binding="{Binding RentalPeriod}" Width="150" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="승인 처리" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="승인" Background="#10B981" Foreground="White" BorderThickness="0" Padding="12,4" FontWeight="Bold" Margin="0,0,8,0" Click="BtnApproveRequest_Click" CommandParameter="{Binding}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="반려" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="12,4" FontWeight="Bold" Click="BtnRejectRequest_Click" CommandParameter="{Binding}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Section 2: Cabinet Layout -->
                        <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,10,0,10">
                            <!-- Pagination Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button x:Name="BtnCabinetPrev" Content="◀" Width="40" Height="40" Padding="0" Click="BtnCabinetPrev_Click" Style="{StaticResource ActionBarBtn}" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtCabinetPageNum" Text="1 / 2" FontSize="14" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center" HorizontalAlignment="Center" Width="60" TextAlignment="Center" Margin="10,0"/>
                                <Button x:Name="BtnCabinetNext" Content="▶" Width="40" Height="40" Padding="0" Click="BtnCabinetNext_Click" Style="{StaticResource ActionBarBtn}" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Upper Cabinet Block (1-24) -->
                            <Border x:Name="BorderCabinetBlock1" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="10" CornerRadius="8" Visibility="Visible">
                                <UniformGrid x:Name="GridCabinetBlock1" Columns="8" Rows="3" Width="900" Height="345"/>
                            </Border>

                            <!-- Lower Cabinet Block (25-48) -->
                            <Border x:Name="BorderCabinetBlock2" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="10" CornerRadius="8" Visibility="Collapsed">
                                <UniformGrid x:Name="GridCabinetBlock2" Columns="8" Rows="3" Width="900" Height="345"/>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Status Counters -->
                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Border BorderBrush="#D1D5DB" BorderThickness="1.5" CornerRadius="6" Background="White" Padding="15,6" Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="사용 가능한 캐비닛 : " FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                                    <TextBlock x:Name="TxtAvailableCabinetCount" Text="00개" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#D1D5DB" BorderThickness="1.5" CornerRadius="6" Background="White" Padding="15,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="사용 중인 캐비닛 : " FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                                    <TextBlock x:Name="TxtRentedCabinetCount" Text="00개" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </Viewbox>
                </Grid>

                <!-- ================= TAB 4: SANGSANGLAB APPROVAL ================= -->
                <Grid x:Name="TabSangsangLab" Visibility="Collapsed" Background="#F9FAFB" Margin="20">
                    <Grid.RowDefinitions>
                        <!-- Top Alert Card -->
                        <RowDefinition Height="Auto"/>
                        <!-- Spacer -->
                        <RowDefinition Height="15"/>
                        <!-- Section Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Cards Container -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Alert -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Alert Card -->
                        <Border Grid.Column="0" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,6" Cursor="Hand" MouseDown="AlertEquipment_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕒" FontSize="18" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="상상Lab 승인 대기" FontSize="10" Foreground="#9A3412" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtSangsangLabPendingCount" Text="7건" FontSize="12" Foreground="#EA580C" FontWeight="Bold"/>
                                    <TextBlock Text="빠른 확인 필요" FontSize="9" Foreground="#9A3412"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="📋 승인/반려 내역" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ActionBarBtn}" Padding="15,8" Tag="상상Lab" Click="BtnShowApprovalHistory_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="상상Lab 신청 및 승인 대기 (구글폼)" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

                    <!-- Cards ScrollViewer -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstSangsangLabCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="-10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="190" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Margin="10" Padding="18">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#9CA3AF" Opacity="0.15"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Card Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="상상Lab 신청" FontSize="14" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="신규 요청" FontSize="9" FontWeight="Bold" Foreground="#2563EB"/>
                                                </Border>
                                            </Grid>

                                            <!-- Card Content -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="👤 신청자" FontSize="11" Foreground="#4B5563" Width="70"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StudentName}" FontSize="11" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="더보기" Background="Transparent" BorderThickness="0" Foreground="#4B5563" FontSize="10" Cursor="Hand" Click="BtnViewSangsangLabDetails_Click" CommandParameter="{Binding}"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="🕒 요청 시간" FontSize="11" Foreground="#4B5563" Width="70"/>
                                                    <TextBlock Text="{Binding RequestDate, StringFormat=\{0:yyyy-MM-dd 14:00 ~ 16:00\}}" FontSize="11" Foreground="#1F2937"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🏢 희망 공간" FontSize="11" Foreground="#4B5563" Width="70"/>
                                                    <TextBlock Text="u301" FontSize="11" FontWeight="Bold" Foreground="#1F2937"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Card Actions -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="✓ 승인" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="0,8" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="BtnApproveRequest_Click" CommandParameter="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                </Button>

                                                <Button Grid.Column="2" Content="✕ 반려" Background="White" BorderBrush="#EF4444" BorderThickness="1" Foreground="#EF4444" Padding="0,7" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="BtnRejectRequest_Click" CommandParameter="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= TAB 5: DATA MANAGEMENT ================= -->
                <Grid x:Name="TabDataManage" Visibility="Collapsed" Background="#F9FAFB" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="데이터 관리 (마스터 데이터베이스)" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="구글 폼 연동 마스터 데이터입니다. 여기서 수정/삭제해도 대시보드의 현재 좌석 데이터가 즉시 손실되지 않습니다." FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Student Search Bar -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="검색어 (학번/이름/지도교수): " FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearchStudent" Width="200" Padding="5" VerticalContentAlignment="Center" KeyUp="TxtSearchStudent_KeyUp" Margin="0,0,10,0"/>
                            <Button Content="🔍 검색" Style="{StaticResource ActionBarBtn}" Padding="15,6" Click="BtnSearchStudent_Click" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ActionBarBtn}" Padding="15,6" Click="BtnClearStudentSearch_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="전체보기" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnImportDataManageExcel" Content="📥 엑셀 가져오기" Style="{StaticResource ActionBarBtn}" Padding="15,6" Click="BtnImportDataManageExcel_Click"/>
                            <Button x:Name="BtnDeleteAllStudents" Content="🗑️ 전체 삭제" Style="{StaticResource ActionBarBtn}" Padding="15,6" Click="BtnDeleteAllStudents_Click" Background="#EF4444" Foreground="White" BorderBrush="#DC2626" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Master Student DataGrid -->
                            <DataGrid Grid.Column="0" x:Name="GridMasterStudents" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="35" BorderThickness="0" Background="Transparent" SelectionChanged="GridMasterStudents_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="학번" Binding="{Binding StudentId}" Width="100"/>
                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="100"/>
                                    <DataGridTextColumn Header="소속" Binding="{Binding Department}" Width="150"/>
                                    <DataGridTextColumn Header="지도교수" Binding="{Binding Advisor}" Width="100"/>
                                    <DataGridTextColumn Header="이메일" Binding="{Binding Email}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- View/Edit Details Panel -->
                            <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0" Margin="15,0,0,0" Padding="15,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PanelMasterEdit" IsEnabled="False">
                                        <TextBlock Text="학생 정보 상세" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>

                                        <TextBlock Text="학번" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox x:Name="TxtMasterId" Margin="0,2,0,8" Padding="5"/>

                                        <TextBlock Text="이름" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox x:Name="TxtMasterName" Margin="0,2,0,8" Padding="5"/>

                                        <TextBlock Text="소속" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox x:Name="TxtMasterDept" Margin="0,2,0,8" Padding="5"/>

                                        <TextBlock Text="지도교수" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox x:Name="TxtMasterAdvisor" Margin="0,2,0,8" Padding="5"/>

                                        <TextBlock Text="이메일" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox x:Name="TxtMasterEmail" Margin="0,2,0,15" Padding="5"/>

                                        <Button Content="변경 사항 저장" Background="#10B981" Foreground="White" BorderThickness="0" Padding="0,8" FontWeight="Bold" Click="BtnSaveMaster_Click"/>
                                        <Button Content="마스터에서 삭제" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="0,8" FontWeight="Bold" Margin="0,8,0,0" Click="BtnDeleteMaster_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= TAB 6: SETTINGS ================= -->
                <Grid x:Name="TabSettings" Visibility="Collapsed" Background="#F9FAFB" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="설정" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="시스템 정보" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                                    <TextBlock Text="프로그램명: 동서대학교 좌석 및 기자재 대여 관리 프로그램" Margin="0,0,0,5"/>
                                    <TextBlock Text="버전: v1.0.0" Margin="0,0,0,5"/>
                                    <TextBlock Text="플랫폼: .NET 10.0 WPF Application" Margin="0,0,0,15"/>

                                    <TextBlock Text="구글 폼 연동 설정" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,15,0,10"/>
                                    
                                    <TextBlock Text="상상Lab용 구글 폼 URL" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSangsangLabFormUrl" Height="35" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,10" VerticalAlignment="Center"/>

                                    <TextBlock Text="캐비닛용 구글 폼 URL" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCabinetFormUrl" Height="35" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,4" VerticalAlignment="Center"/>
                                    <TextBlock Text="※ 캐비닛 폼의 [응답] → [시트에서 보기] 스프레드시트 주소를 넣으면, 캐비닛 신청을 이 시트에서 따로 받아옵니다 (모두 '캐비닛'으로 등록). 이 시트도 아래 서비스 계정에 '뷰어' 공유가 필요합니다."
                                               FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <TextBlock Text="기자재용 구글 폼 URL" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtEquipmentFormUrl" Height="35" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,4" VerticalAlignment="Center"/>
                                    <TextBlock Text="※ 기자재 폼의 [응답] → [시트에서 보기] 스프레드시트 주소를 넣으면, 기자재 신청을 이 시트에서 따로 받아옵니다 (모두 '기자재'로 등록). 이 시트도 아래 서비스 계정에 '뷰어' 공유가 필요합니다."
                                               FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- ===== 구글 시트 실연동 ===== -->
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="구글 시트 연동 (실제 신청 수신)" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>

                                            <TextBlock Text="응답 스프레드시트 ID" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSpreadsheetId" Height="35" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,10" VerticalAlignment="Center"/>

                                            <TextBlock Text="서비스 계정 (이 주소로 시트를 '뷰어' 공유해야 합니다)" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtServiceAccountEmail" Height="30" IsReadOnly="True" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,5" Margin="0,0,0,8" FontSize="11" VerticalContentAlignment="Center"/>

                                            <TextBlock Text="키 파일 위치" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtKeyPath" Grid.Column="0" Height="30" IsReadOnly="True" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,5" FontSize="11" VerticalContentAlignment="Center"/>
                                                <Button x:Name="BtnPickKeyFile" Grid.Column="1" Content="📂 키 파일 선택..." Padding="12,6" Margin="8,0,0,0" Style="{StaticResource ActionBarBtn}" Click="BtnPickKeyFile_Click"/>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <CheckBox x:Name="ChkPollingEnabled" Content="자동 동기화" VerticalAlignment="Center" FontSize="12" Checked="ChkPollingEnabled_Changed" Unchecked="ChkPollingEnabled_Changed"/>
                                                <TextBlock Text="주기(초):" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                                <TextBox x:Name="TxtPollingInterval" Width="70" Height="28" BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,2" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Button x:Name="BtnSyncNow" Content="🔄 지금 동기화" Padding="15,8" Style="{StaticResource ActionBarBtn}" Click="BtnSyncNow_Click"/>
                                                <Button Content="💾 연동 설정 저장" Padding="15,8" Margin="10,0,0,0" Style="{StaticResource ActionBarBtn}" Click="BtnSaveSyncSettings_Click"/>
                                            </StackPanel>

                                            <TextBlock x:Name="TxtSyncStatus" Text="대기 중" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="화면 해상도 설정" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,10,0,10"/>
                                    <ComboBox x:Name="ComboResolution" Width="200" Padding="5" HorizontalAlignment="Left" Margin="0,0,0,15" SelectionChanged="ComboResolution_SelectionChanged">
                                        <ComboBoxItem Content="기본 (1600 x 900)"/>
                                        <ComboBoxItem Content="소형 (1024 x 768)"/>
                                        <ComboBoxItem Content="중형 (1200 x 780)"/>
                                        <ComboBoxItem Content="대형 (1920 x 1080)"/>
                                    </ComboBox>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= SEAT DETAIL PANEL / MODAL OVERLAY ================= -->
        <Grid x:Name="ModalSeatDetails" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="820" Height="300" CornerRadius="20" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hidden elements for compilation compatibility -->
                    <TextBlock x:Name="TxtModalSeatNum" Visibility="Collapsed"/>
                    <ItemsControl x:Name="ItemsModalAttendance" Visibility="Collapsed"/>

                    <!-- Close button in top-right, Select Student button nearby -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,-15,0,0">
                        <Button x:Name="BtnSelectStudent" Content="학생선택" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="15,6" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="BtnSelectStudent_Click" Margin="0,0,15,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnEditStudentInfo" Content="정보 수정" Background="#F3F4F6" Foreground="#374151" BorderThickness="0" Padding="15,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="BtnEditStudentInfo_Click" Margin="0,0,15,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnCloseModal" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCloseModal_Click" Padding="5">
                            <TextBlock Text="✕" FontSize="24" Foreground="#111827"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="0" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <!-- Student Profile info -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Student Profile -->
                        <Grid Grid.Row="0" Margin="20,10,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Column 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="이름 : " FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtModalName" Text="홍길동" FontSize="20" FontWeight="Bold" Foreground="Black" BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="지도 교수 : " FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtModalAdvisor" Text="김선용" FontSize="20" FontWeight="Bold" Foreground="Black" BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="이메일 : " FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtModalEmail" Text="gildong123@naver.com" FontSize="20" FontWeight="Bold" Foreground="Black" BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center" Width="300"/>
                            </StackPanel>

                            <!-- Column 2 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                <TextBlock Text="소속 : " FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtModalDept" Text="소프트웨어 전공" FontSize="20" FontWeight="Bold" Foreground="Black" BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                <TextBlock Text="학번 : " FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModalId" Text="20261234" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                <TextBlock Text="캐비닛 사용 : " FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtModalCabinet" Text="사용 안 함" FontSize="20" FontWeight="Bold" Foreground="Black" BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Footer Action buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="BtnEditStudentModal" Content="좌석 수정" Background="#10B981" Foreground="White" BorderThickness="0" Padding="20,8" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand" Click="BtnEditStudentModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= STUDENT SELECTOR OVERLAY ================= -->
        <!-- 다른 모달(캐비닛 상세 ZIndex 100) 위에서 열려야 하므로 그보다 높게 둔다 (로딩 오버레이 200보다는 아래) -->
        <Grid x:Name="ModalStudentListSelector" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="150">
            <Border Background="White" Width="550" Height="480" CornerRadius="20" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnCloseStudentSelector" Content="✕" Style="{StaticResource IconBtn}" Click="BtnCloseStudentSelector_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"/>

                    <TextBlock Grid.Row="0" Text="학생 선택" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

                    <!-- Search bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearchStudentSelector" Height="35" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,5" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="TxtSearchStudentSelector_TextChanged"/>
                        <Button Grid.Column="1" Content="🔍 검색" Style="{StaticResource ActionBarBtn}" Padding="15,6" Click="BtnSearchStudentSelector_Click"/>
                    </Grid>

                    <!-- Student list -->
                    <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Background="#F9FAFB">
                        <DataGrid x:Name="GridStudentSelector" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="35" BorderThickness="0" Background="Transparent" MouseDoubleClick="GridStudentSelector_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="학번" Binding="{Binding StudentId}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn x:Name="ColStudentDept" Header="소속" Binding="{Binding Department}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn x:Name="ColStudentCabinetPeriod" Header="대여 기간" Binding="{Binding CabinetPeriod}" Width="200" IsReadOnly="True" Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="선택" Style="{StaticResource ModalBtn}" Padding="20,8" Margin="0,0,8,0" Click="BtnConfirmStudentSelection_Click"/>
                        <Button Content="취소" Style="{StaticResource ModalBtn}" Background="#F3F4F6" Foreground="#374151" Padding="20,8" Click="BtnCloseStudentSelector_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= APPROVAL/REJECTION HISTORY OVERLAY ================= -->
        <Grid x:Name="ModalApprovalHistory" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="900" Height="520" CornerRadius="20" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnCloseApprovalHistory" Content="✕" Style="{StaticResource IconBtn}" Click="BtnCloseApprovalHistory_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"/>

                    <TextBlock x:Name="TxtApprovalHistoryTitle" Grid.Row="0" Text="승인/반려 내역 확인" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Background="#F9FAFB">
                        <DataGrid x:Name="GridApprovalHistory" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="구분" Binding="{Binding TabType}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="신청 일자" Binding="{Binding RequestDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="학번" Binding="{Binding StudentId}" Width="85" IsReadOnly="True"/>
                                <DataGridTextColumn Header="이름" Binding="{Binding StudentName}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="소속" Binding="{Binding Department}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="대기 목록으로 복구" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="되돌리기" Style="{StaticResource ModalBtn}" Background="#3B82F6" Padding="12,4" FontSize="12" VerticalAlignment="Center" Click="BtnRestoreFromHistory_Click" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= RENTAL HISTORY OVERLAY ================= -->
        <Grid x:Name="ModalRentalHistory" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" Width="900" Height="520" CornerRadius="20" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnCloseRentalHistory" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCloseRentalHistory_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
                        <TextBlock Text="✕" FontSize="20" Foreground="#111827"/>
                    </Button>

                    <TextBlock Grid.Row="0" Text="기자재 대여 내역 확인" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Background="#F9FAFB">
                        <DataGrid x:Name="GridRentalHistory" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="대여자 이름" Binding="{Binding StudentName}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="대여 기자재" Binding="{Binding DisplayEquipment}" Width="250" IsReadOnly="True"/>
                                <DataGridTextColumn Header="대여일" Binding="{Binding RentalDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="반납 기한" Binding="{Binding DueDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="130" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="반납 여부" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReturned}" Value="True">
                                                                <Setter Property="Text" Value="반납 완료"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsReturned}" Value="False">
                                                                <Setter Property="Text" Value="대여 중"/>
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- ================= CABINET DETAIL MODAL OVERLAY ================= -->
        <Grid x:Name="ModalCabinetDetails" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="White" Width="600" Height="400" CornerRadius="20" Padding="35" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-15,0,0">
                        <Button x:Name="BtnSelectCabinetStudent" Content="학생선택" Visibility="Collapsed" Style="{StaticResource ModalBtn}" Padding="15,6" FontSize="12" Click="BtnSelectCabinetStudent_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnEditCabinetInfo" Content="정보 수정" Style="{StaticResource ModalBtn}" Background="#F3F4F6" Foreground="#374151" Padding="15,6" FontSize="12" FontWeight="SemiBold" Click="BtnEditCabinetInfo_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnCloseCabinetModal" Content="✕" Style="{StaticResource IconBtn}" Click="BtnCloseCabinetModal_Click"/>
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock x:Name="TxtCabinetModalTitle" Text="캐비닛 00번 상세 정보" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                    <!-- Fields -->
                    <Grid Grid.Row="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="이름 : " FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>
                        <TextBox x:Name="TxtCabinetModalName" Grid.Row="0" Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="#111827" Background="Transparent" BorderThickness="0" IsReadOnly="True" Margin="0,0,0,15"/>

                        <!-- ID -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="학번 : " FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>
                        <TextBox x:Name="TxtCabinetModalId" Grid.Row="1" Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="#111827" Background="Transparent" BorderThickness="0" IsReadOnly="True" Margin="0,0,0,15"/>

                        <!-- Period -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="대여 기간 : " FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBox x:Name="TxtCabinetModalPeriod" Grid.Row="2" Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="#111827" Background="Transparent" BorderThickness="0" IsReadOnly="True"/>
                    </Grid>

                    <!-- Save Button (Only visible during edit) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="BtnMoveCabinet" Content="🔄 좌석 옮기기" Visibility="Collapsed" Style="{StaticResource ModalBtn}" Padding="20,8" Click="BtnMoveCabinet_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSaveCabinetModal" Content="저장" Visibility="Collapsed" Style="{StaticResource ModalBtn}" Background="#10B981" Padding="20,8" Click="BtnSaveCabinetModal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= LOADING OVERLAY ================= -->
        <Grid x:Name="ModalLoading" Grid.ColumnSpan="2" Background="#70000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Background="White" Width="300" Height="150" CornerRadius="12" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="↻" FontSize="36" Foreground="#2563EB" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="구글 폼 데이터 동기화 중..." FontSize="14" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
